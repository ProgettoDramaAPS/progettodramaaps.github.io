---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const pagina = await getEntry('pagine', 'home');
---

<Layout titolo={pagina.data.titolo}>
  <div class="full-bleed hero">
    <img class="hero__logo" src="/logo-negativo.png" alt="Progetto Drama" />
    <p class="hero__testo">
      Riattiviamo la Bocciofila del Parco Caselli. Un posto aperto dove ci si incontra,
      si fa qualcosa insieme, si torna.
    </p>
    <p class="hero__orari">
      Siamo aperti con aula studio e co-working<br />dal lunedì al venerdì (9:30-18:00)
    </p>
    <div class="azioni azioni--centro">
      <a class="btn btn-primary" href="/iscrizioni">Diventa socio</a>
      <a class="btn btn-on-dark" href="/eventi">Scopri gli eventi</a>
    </div>
    <p class="hero__instagram">
      Seguici sulla <a href="https://www.instagram.com/progettodrama/">pagina Instagram</a> per restare aggiornato su tutte le nostre iniziative.
    </p>
  </div>
</Layout>

<style>
  .full-bleed {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    box-sizing: border-box;
  }

  .hero {
    background: var(--pd-viola-drama);
    padding: 56px 24px;
    margin-top: -2rem;
    margin-bottom: -4rem;
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .hero__logo {
    height: 110px;
    width: auto;
  }
  .hero__testo {
    max-width: 42ch;
    margin: 24px auto 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--pd-celeste);
  }
  .hero__orari {
    max-width: 42ch;
    margin: 12px auto 0;
    font-size: 13px;
    font-style: italic;
    line-height: 1.6;
    color: var(--pd-celeste);
  }
  .hero__instagram {
    margin: 20px 0 0;
    font-size: 13px;
    color: var(--pd-celeste);
  }
  .hero__instagram a {
    color: var(--pd-bianco);
  }

  .azioni--centro {
    justify-content: center;
    margin-top: 24px;
  }

  @media (min-width: 640px) {
    .hero {
      padding: 88px 40px 72px;
    }
    .hero__logo {
      height: 160px;
    }
  }
</style>
